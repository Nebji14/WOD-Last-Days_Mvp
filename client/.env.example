# Copier ce fichier en « .env.local ». Ce fichier ne contient aucun secret.

# Adresse du serveur FastAPI, appelée par le proxy du client (jamais par le navigateur)
API_URL=http://localhost:8000

# Adresse WebSocket du serveur temps réel (étape 3)
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8000

# Chemin réservé de l'accès du MJ, sans barre oblique (même valeur que dans server/.env)
GM_ACCESS_PATH=mj-dev
