# Copier ce fichier en « .env » et renseigner les valeurs. Le fichier .env n'est jamais commité.

# development | production
ENVIRONMENT=development

# Supabase : Project Settings → API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète (sb_secret_… ou service_role). Ne quitte jamais le serveur.
SUPABASE_SECRET_KEY=

# Supabase : Connect → Connection string → Session pooler (URI)
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@<hote>:5432/postgres

# Origines autorisées du client, séparées par des virgules
ALLOWED_ORIGINS=http://localhost:3000

# Durée d'inactivité avant expiration de la session, en secondes
SESSION_IDLE_SECONDS=7200

# Adresse publique du client : Google y ramène le navigateur après la connexion.
# L'adresse <PUBLIC_APP_URL>/api/auth/google/callback doit figurer dans les Redirect URLs de Supabase.
PUBLIC_APP_URL=http://localhost:3000

# Chemin réservé de l'accès du MJ côté client, sans barre oblique (même valeur que dans client/.env.local)
GM_ACCESS_PATH=mj-dev

# Clé de l'API YouTube (Google Cloud, « YouTube Data API v3 »), pour la recherche de musique.
# À restreindre à cette seule API. Vide : l'outil Musique signale qu'il n'est pas configuré.
YOUTUBE_API_KEY=
